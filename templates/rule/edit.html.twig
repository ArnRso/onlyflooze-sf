{% extends 'base.html.twig' %}

{% block title %}Modifier la règle {{ rule.name }} — OnlyFlooze{% endblock %}

{% block body %}
    <h1 class="h3 mb-4">Modifier la règle « {{ rule.name }} »</h1>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_row(form.name) }}
                {{ form_row(form.category) }}
                {{ form_row(form.tokens) }}
                {{ form_row(form.amountCents) }}
                {{ form_row(form.nature) }}
                {{ form_row(form.recurrenceOptOut) }}
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                <a class="btn btn-outline-secondary" href="{{ path('app_rules') }}">Annuler</a>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
