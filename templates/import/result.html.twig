{% extends 'base.html.twig' %}

{% block title %}Résultat d'import — OnlyFlooze{% endblock %}

{% block body %}
    <h1 class="h3 mb-4">Import terminé</h1>

    <div class="card mb-4">
        <div class="card-body">
            <p class="mb-2"><strong>{{ batch.filename }}</strong> — {{ batch.createdAt|date('d/m/Y H:i') }}</p>
            <ul class="mb-0">
                <li><strong>{{ batch.newCount }}</strong> nouvelle(s) transaction(s)</li>
                <li><strong>{{ batch.duplicateCount }}</strong> doublon(s) ignoré(s) (déjà en base)</li>
                <li><strong>{{ batch.suggestedCount }}</strong> avec suggestion à valider</li>
                <li><strong>{{ batch.toReviewCount }}</strong> à trier</li>
            </ul>
        </div>
    </div>

    <div class="d-flex gap-2">
        {% if batch.toReviewCount + batch.suggestedCount > 0 %}
            <a class="btn btn-primary" href="{{ path('app_review') }}">Trier maintenant</a>
        {% endif %}
        <a class="btn btn-outline-secondary" href="{{ path('app_home') }}">Retour au dashboard</a>
        <a class="btn btn-outline-secondary" href="{{ path('app_import') }}">Nouvel import</a>
    </div>
{% endblock %}
