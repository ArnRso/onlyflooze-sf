{% extends 'base.html.twig' %}

{% block title %}Dashboard {{ overview.month|date('m/Y') }} — OnlyFlooze{% endblock %}

{% block body %}
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0">Dashboard — {{ overview.month|date('m/Y') }}</h1>
        <div class="btn-group">
            <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_home', {month: overview.month|date_modify('-1 month')|date('Y-m')}) }}">← {{ overview.month|date_modify('-1 month')|date('m/Y') }}</a>
            <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_home') }}">Ce mois</a>
            <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_home', {month: overview.month|date_modify('+1 month')|date('Y-m')}) }}">{{ overview.month|date_modify('+1 month')|date('m/Y') }} →</a>
        </div>
    </div>

    {% if overview.toReviewCount > 0 %}
        <div class="alert alert-warning d-flex justify-content-between align-items-center">
            <span><strong>{{ overview.toReviewCount }}</strong> transaction(s) à trier.</span>
            <a class="btn btn-warning btn-sm" href="{{ path('app_review') }}">Trier maintenant</a>
        </div>
    {% endif %}

    {% set forecast = overview.recurrenceForecast %}
    {% macro info(text) %}<span class="text-muted ms-1" data-controller="tooltip" data-bs-title="{{ text }}" role="img" aria-label="{{ text }}">ⓘ</span>{% endmacro %}

    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Revenus</div>
                    <div class="fs-4 text-success">{{ overview.incomeCents|money }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Dépenses</div>
                    <div class="fs-4 text-danger">{{ overview.expenseCents|money }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Net du mois</div>
                    <div class="fs-4 {{ overview.netCents < 0 ? 'text-danger' : 'text-success' }}">{{ overview.netCents|money(true) }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card h-100 border-danger-subtle">
                <div class="card-body">
                    <div class="text-muted small">Reste à sortir{{ _self.info('Récurrences de dépense à venir ou en retard ce mois-ci, au montant attendu') }}</div>
                    <div class="fs-4 text-danger">{{ forecast.remainingDebitCents|money }}</div>
                    <div class="small text-muted">{{ forecast.remainingDebitCount }} récurrence(s) · déjà passé {{ forecast.passedDebitCents|money }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-success-subtle">
                <div class="card-body">
                    <div class="text-muted small">Reste à rentrer{{ _self.info('Récurrences de revenu à venir ou en retard ce mois-ci, au montant attendu') }}</div>
                    <div class="fs-4 text-success">{{ forecast.remainingCreditCents|money }}</div>
                    <div class="small text-muted">{{ forecast.remainingCreditCount }} récurrence(s) · déjà passé {{ forecast.passedCreditCents|money }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-primary-subtle">
                <div class="card-body">
                    <div class="text-muted small">Estimation fin de mois{{ _self.info('Net du mois + reste à sortir + reste à rentrer') }}</div>
                    <div class="fs-4 {{ overview.estimatedEndOfMonthCents < 0 ? 'text-danger' : 'text-success' }}">{{ overview.estimatedEndOfMonthCents|money(true) }}</div>
                    <div class="small text-muted">{{ overview.netCents|money(true) }} {{ forecast.remainingCents|money(true) }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">Par poste de budget</div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0 align-middle">
                        <thead>
                            <tr>
                                <th class="ps-3">Poste</th>
                                <th class="text-end">{{ overview.month|date('m/Y') }}</th>
                                <th class="text-end pe-3">Mois précédent</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for total in overview.categoryTotals %}
                                <tr>
                                    <td class="ps-3">
                                        {% if total.category %}
                                            {{ total.category.name }}
                                        {% else %}
                                            <span class="text-muted">À trier</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">{{ total.amountCents|money }}</td>
                                    <td class="text-end pe-3 text-muted">{{ total.previousAmountCents|money }}</td>
                                </tr>
                            {% else %}
                                <tr><td colspan="3" class="text-center text-muted py-4">Aucune transaction ce mois-ci.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">Récurrences du mois</div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0 align-middle">
                        <tbody>
                            {% for status in overview.recurrenceStatuses %}
                                <tr>
                                    <td class="ps-3"><a href="{{ path('app_recurrence_show', {id: status.recurrence.id}) }}" class="text-decoration-none">{{ status.recurrence.name }}</a></td>
                                    <td class="text-muted text-nowrap">le {{ status.expectedDate|date('d/m') }}</td>
                                    <td class="text-end text-nowrap">
                                        {% if status.transaction %}
                                            {{ status.transaction.amountCents|money }}
                                            {% if status.transaction.amountOutOfTolerance %}
                                                <span class="badge text-bg-warning" title="Montant hors tolérance (attendu {{ status.recurrence.expectedAmountCents|money }})">⚠</span>
                                            {% endif %}
                                        {% else %}
                                            <span class="text-muted">~{{ status.recurrence.expectedAmountCents|money }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end pe-3">
                                        {% if status.state.value == 'passed' %}
                                            <span class="badge text-bg-success">Passée</span>
                                        {% elseif status.state.value == 'upcoming' %}
                                            <span class="badge text-bg-secondary">À venir</span>
                                        {% else %}
                                            <span class="badge text-bg-danger">En retard</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td class="text-center text-muted py-4">
                                        Aucune récurrence suivie. <a href="{{ path('app_recurrences') }}">Voir les propositions</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">6 derniers mois</div>
        <div class="card-body" style="height: 280px;">
            {{ render_chart(overview.historyChart) }}
        </div>
    </div>
{% endblock %}
