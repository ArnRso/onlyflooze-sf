{% extends 'base.html.twig' %}

{% block title %}Modifier une transaction — OnlyFlooze{% endblock %}

{% block body %}
    <h1 class="h3 mb-4">Modifier la transaction</h1>

    <div class="card mb-4">
        <div class="card-body">
            <p class="mb-1"><strong>{{ transaction.label }}</strong></p>
            <p class="mb-0 text-muted">
                {{ transaction.operationDate|date('d/m/Y') }} —
                <span class="{{ transaction.amountCents < 0 ? 'text-danger' : 'text-success' }}">{{ transaction.amountCents|money(true) }}</span>
                — {{ transaction.type.label }}
                {% if transaction.recurrence %}
                    — récurrence « {{ transaction.recurrence.name }} »
                {% endif %}
            </p>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_row(form.category) }}
                {{ form_row(form.nature) }}
                {{ form_row(form.tags) }}
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                <a class="btn btn-outline-secondary" href="{{ path('app_transactions') }}">Annuler</a>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
