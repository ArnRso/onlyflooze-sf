{% extends 'base.html.twig' %}

{% block title %}Transactions — OnlyFlooze{% endblock %}

{% block body %}
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0">Transactions</h1>
        <span class="text-muted">{{ total }} au total</span>
    </div>

    <form method="get" class="card mb-3">
        <div class="card-body row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label" for="filter-q">Recherche</label>
                <input type="search" class="form-control form-control-sm" id="filter-q" name="q" value="{{ search }}" placeholder="Libellé…">
            </div>
            <div class="col-md-4">
                <label class="form-label" for="filter-category">Catégorie</label>
                <select class="form-select form-select-sm" id="filter-category" name="category">
                    <option value="">Toutes</option>
                    {% for category in categories %}
                        <option value="{{ category.id }}" {{ selectedCategory and selectedCategory.id == category.id ? 'selected' }}>{{ category.fullName }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2 form-check ms-2 mb-2">
                <input class="form-check-input" type="checkbox" id="filter-to-review" name="to_review" value="1" {{ onlyToReview ? 'checked' }}>
                <label class="form-check-label" for="filter-to-review">À trier</label>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-outline-primary">Filtrer</button>
            </div>
        </div>
    </form>

    <div class="card">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-3">Date</th>
                    <th>Libellé</th>
                    <th class="text-end">Montant</th>
                    <th>Catégorie</th>
                    <th>Nature</th>
                    <th>Tags</th>
                    <th class="pe-3"></th>
                </tr>
            </thead>
            <tbody>
                {% for transaction in transactions %}
                    <tr>
                        <td class="ps-3 text-nowrap">{{ transaction.operationDate|date('d/m/Y') }}</td>
                        <td>
                            {{ transaction.label }}
                            {% if transaction.recurrence %}
                                <span class="badge text-bg-info" title="Récurrence : {{ transaction.recurrence.name }}">↻</span>
                            {% endif %}
                            {% if transaction.amountOutOfTolerance %}
                                <span class="badge text-bg-warning" title="Montant hors tolérance de la récurrence">⚠</span>
                            {% endif %}
                        </td>
                        <td class="text-end text-nowrap {{ transaction.amountCents < 0 ? 'text-danger' : 'text-success' }}">{{ transaction.amountCents|money(true) }}</td>
                        <td>
                            {% if transaction.category %}
                                {{ transaction.category.fullName }}
                            {% else %}
                                <span class="text-muted">À trier</span>
                            {% endif %}
                        </td>
                        <td>{{ transaction.nature.label }}</td>
                        <td>
                            {% for tag in transaction.tags %}
                                <span class="badge text-bg-light border">{{ tag.name }}</span>
                            {% endfor %}
                        </td>
                        <td class="pe-3 text-end">
                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_transaction_edit', {id: transaction.id}) }}">Modifier</a>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="text-center text-muted py-4">Aucune transaction.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if pageCount > 1 %}
        {% set params = {q: search ?: null, category: selectedCategory ? selectedCategory.id : null, to_review: onlyToReview ? 1 : null} %}
        <nav class="mt-3" aria-label="Pagination">
            <ul class="pagination pagination-sm justify-content-center">
                <li class="page-item {{ page <= 1 ? 'disabled' }}">
                    <a class="page-link" href="{{ path('app_transactions', params|merge({page: page - 1})) }}">←</a>
                </li>
                <li class="page-item disabled"><span class="page-link">{{ page }} / {{ pageCount }}</span></li>
                <li class="page-item {{ page >= pageCount ? 'disabled' }}">
                    <a class="page-link" href="{{ path('app_transactions', params|merge({page: page + 1})) }}">→</a>
                </li>
            </ul>
        </nav>
    {% endif %}
{% endblock %}
