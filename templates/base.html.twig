<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}OnlyFlooze{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>💶</text></svg>">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="bg-body-tertiary">
        {% if app.user %}
            <nav class="navbar navbar-expand-lg bg-body border-bottom mb-4">
                <div class="container">
                    <a class="navbar-brand" href="{{ path('app_home') }}">💶 OnlyFlooze</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Basculer la navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_review') }}">
                                    À trier
                                    <span id="nav-review-badge" class="badge text-bg-danger">{{ to_review_count() }}</span>
                                </a>
                            </li>
                            <li class="nav-item"><a class="nav-link" href="{{ path('app_transactions') }}">Transactions</a></li>
                            <li class="nav-item"><a class="nav-link" href="{{ path('app_recurrences') }}">Récurrences</a></li>
                            <li class="nav-item"><a class="nav-link" href="{{ path('app_import') }}">Import</a></li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Réglages</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="{{ path('app_categories') }}">Catégories</a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_rules') }}">Règles apprises</a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_tags') }}">Tags</a></li>
                                </ul>
                            </li>
                        </ul>
                        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_logout') }}">Déconnexion</a>
                    </div>
                </div>
            </nav>
        {% endif %}

        <main class="container mb-5">
            {{ include('_flash.html.twig') }}
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
