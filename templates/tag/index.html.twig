{% extends 'base.html.twig' %}

{% block title %}Tags — OnlyFlooze{% endblock %}

{% block body %}
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0">Tags</h1>
        <a class="btn btn-primary btn-sm" href="{{ path('app_tag_new') }}">Nouveau tag</a>
    </div>

    <p class="text-muted">
        Pour les axes transverses (vacances-corse, chat, travaux…) : une dépense
        garde son poste de budget ET porte un tag.
    </p>

    <div class="card">
        <table class="table table-sm align-middle mb-0">
            <tbody>
                {% for tag in tags %}
                    <tr>
                        <td class="ps-3"><span class="badge text-bg-light border">{{ tag.name }}</span></td>
                        <td class="text-end pe-3">
                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_tag_edit', {id: tag.id}) }}">Renommer</a>
                            <form method="post" action="{{ path('app_tag_delete', {id: tag.id}) }}" class="d-inline" data-turbo-confirm="Supprimer le tag « {{ tag.name }} » ?">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tag.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td class="text-center text-muted py-4">Aucun tag.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
