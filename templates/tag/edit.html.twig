{% extends 'base.html.twig' %}

{% block title %}Renommer {{ tag.name }} — OnlyFlooze{% endblock %}

{% block body %}
    <h1 class="h3 mb-4">Renommer « {{ tag.name }} »</h1>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_row(form.name) }}
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                <a class="btn btn-outline-secondary" href="{{ path('app_tags') }}">Annuler</a>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
