{% extends 'base.html.twig' %}

{% block title %}{{ recurrence.name }} — OnlyFlooze{% endblock %}

{% block body %}
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0">Récurrence « {{ recurrence.name }} »</h1>
        <div class="d-flex gap-2">
            {% if recurrence.endedAt %}
                <form method="post" action="{{ path('app_recurrence_resume', {id: recurrence.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('resume' ~ recurrence.id) }}">
                    <button type="submit" class="btn btn-sm btn-outline-success">Reprendre le suivi</button>
                </form>
            {% else %}
                <form method="post" action="{{ path('app_recurrence_end', {id: recurrence.id}) }}" data-turbo-confirm="Marquer « {{ recurrence.name }} » comme terminée ? Elle ne sera plus attendue les mois suivants.">
                    <input type="hidden" name="_token" value="{{ csrf_token('end' ~ recurrence.id) }}">
                    <button type="submit" class="btn btn-sm btn-outline-dark">Marquer comme terminée</button>
                </form>
            {% endif %}
            <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_recurrence_edit', {id: recurrence.id}) }}">Modifier</a>
            <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_recurrences') }}">← Retour</a>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <div class="text-muted small">Attendu</div>
                    <div>~{{ recurrence.expectedAmountCents|money }} le {{ recurrence.expectedDayOfMonth }} (±{{ recurrence.tolerancePct }} %, fenêtre ±{{ recurrence.dayWindow }} j)</div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Catégorie</div>
                    <div>{{ recurrence.category ? recurrence.category.fullName : '—' }}</div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Reconnue par</div>
                    <div>
                        {% if recurrence.rule %}
                            règle <a href="{{ path('app_rule_edit', {id: recurrence.rule.id}) }}">{{ recurrence.rule.name }}</a>
                        {% elseif recurrence.tokens is not empty %}
                            {% for token in recurrence.tokens %}<span class="badge text-bg-light border">{{ token }}</span> {% endfor %}
                        {% else %}
                            date + montant
                        {% endif %}
                        {% if recurrence.fingerprints is not empty %}
                            <span class="badge text-bg-light border" title="{{ recurrence.fingerprints|join('&#10;') }}">{{ recurrence.fingerprints|length }} libellé(s) appris</span>
                        {% endif %}
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Ce mois-ci</div>
                    <div>
                        {% if status.state.value == 'passed' %}
                            <span class="badge text-bg-success">Passée</span>
                        {% elseif status.state.value == 'upcoming' %}
                            <span class="badge text-bg-secondary">À venir le {{ status.expectedDate|date('d/m') }}</span>
                        {% elseif status.state.value == 'ended' %}
                            <span class="badge text-bg-dark">Terminée le {{ recurrence.endedAt|date('d/m/Y') }}</span>
                        {% elseif status.state.value == 'not_started' %}
                            <span class="badge text-bg-light text-muted border">Pas encore commencée</span>
                        {% else %}
                            <span class="badge text-bg-danger">En retard (attendue le {{ status.expectedDate|date('d/m') }})</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4 border-primary {{ candidates is empty ? 'd-none' }}" id="backfill-card">
        <div class="card-header text-bg-primary">
            Correspondances possibles dans l'historique (<span id="backfill-count">{{ candidates|length }}</span>) — à valider ligne par ligne
        </div>
        <table class="table table-sm align-middle mb-0">
            <tbody id="backfill-list">
                {% for transaction in candidates %}
                    {{ include('recurrence/_candidate_row.html.twig') }}
                {% endfor %}
            </tbody>
        </table>
    </div>

    <h2 class="h5">Transactions rattachées (<span id="attached-count">{{ transactions|length }}</span>)</h2>
    <div class="card">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-3">Date</th>
                    <th>Libellé</th>
                    <th class="text-end">Montant</th>
                    <th class="text-end">Écart vs attendu</th>
                    <th class="pe-3"></th>
                </tr>
            </thead>
            <tbody id="attached-list">
                {% for transaction in transactions %}
                    {{ include('recurrence/_attached_row.html.twig') }}
                {% else %}
                    <tr id="attached-empty"><td colspan="5" class="text-center text-muted py-4">Aucune transaction rattachée pour l'instant.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
